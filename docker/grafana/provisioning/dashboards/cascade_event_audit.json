      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "selfhealing_cascade_effects_total{namespace=~\"$namespace\",status=\"success\"} / (selfhealing_cascade_effects_total{namespace=~\"$namespace\",status=\"success\"} + selfhealing_cascade_effects_total{namespace=~\"$namespace\",status=\"failure\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{action_type}}",
          "refId": "A"
        }
      ],
      "title": "액션별 성공률",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "Value": "Success Rate",
              "action_type": "Action Type",
              "namespace": "Namespace"
            }
          }
        }
      ],
      "type": "table"
