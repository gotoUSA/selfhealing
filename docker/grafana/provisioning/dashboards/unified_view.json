{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": ["self-healing"],
      "targetBlank": true,
      "title": "Self-Healing Dashboard",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "📊 Metrics 개요 (Request Rate & Error Rate)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Requests/sec",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\"}[5m])) by (service_name)",
          "legendFormat": "{{service_name}}",
          "refId": "A",
          "exemplar": true
        }
      ],
      "title": "📈 요청 처리량 (Request Rate)",
      "description": "초당 요청 처리량을 서비스별로 표시합니다. Exemplar 클릭 시 Tempo에서 해당 Trace를 확인할 수 있습니다.",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Error Rate (%)",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*error.*" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
          "expr": "100 * sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\", http_status_code=~\"5..\"}[5m])) by (service_name) / sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\"}[5m])) by (service_name)",
          "legendFormat": "{{service_name}} error",
          "refId": "A",
          "exemplar": true
        }
      ],
      "title": "❌ 오류율 (Error Rate)",
      "description": "서비스별 HTTP 5xx 오류율을 표시합니다. Exemplar 클릭 시 오류 발생 Trace로 이동합니다.",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Duration (ms)",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["mean", "max", "p95"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\"}[5m])) by (le, service_name)) * 1000",
          "legendFormat": "p95 - {{service_name}}",
          "refId": "A",
          "exemplar": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
          "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\"}[5m])) by (le, service_name)) * 1000",
          "legendFormat": "p99 - {{service_name}}",
          "refId": "B",
          "exemplar": true
        }
      ],
      "title": "⏱️ 응답 시간 P95/P99 (Latency with Exemplars)",
      "description": "응답 시간 백분위수입니다. 500ms 이상은 SLA Critical입니다. Exemplar 점 클릭 시 해당 느린 요청의 Trace로 이동합니다.",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 101,
      "panels": [],
      "title": "🔍 Trace Viewer (분산 추적)",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 4,
      "options": {
        "nodes": {
          "mainStatUnit": "ms"
        },
        "edges": {
          "mainStatUnit": "r/s"
        }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "serviceMap",
          "refId": "A",
          "filters": [
            { "id": "service-name", "tag": "service.name", "operator": "=~", "value": ["$service"] }
          ]
        }
      ],
      "title": "🗺️ 서비스 호출 관계도 (Service Map)",
      "description": "서비스 간 호출 관계를 시각화합니다. 노드 클릭 시 해당 서비스의 Trace 목록으로 이동합니다.",
      "type": "nodeGraph"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "filterable": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Trace ID" },
            "properties": [
              { "id": "custom.width", "value": 280 },
              { "id": "links", "value": [{ "title": "View Full Trace", "url": "/explore?orgId=1&left=%5B%22now-1h%22,%22now%22,%22Tempo%22,%7B%22queryType%22:%22traceId%22,%22query%22:%22${__value.text}%22%7D%5D" }] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Duration" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "custom.width", "value": 120 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Start Time" },
            "properties": [{ "id": "custom.width", "value": 180 }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 24 },
      "id": 5,
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" },
        "sortBy": [{ "desc": true, "displayName": "Start Time" }]
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "search",
          "refId": "A",
          "filters": [
            { "id": "service-name", "tag": "service.name", "operator": "=~", "value": ["$service"] }
          ],
          "limit": 20
        }
      ],
      "title": "📋 최근 Trace 목록",
      "description": "최근 Trace 목록입니다. Trace ID 클릭 시 상세 보기로 이동하고 관련 로그를 확인할 수 있습니다.",
      "type": "table",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "traceID": "Trace ID",
              "traceDuration": "Duration",
              "rootServiceName": "Service",
              "rootTraceName": "Operation",
              "startTimeUnixNano": "Start Time"
            }
          }
        }
      ]
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 24 },
      "id": 6,
      "options": {},
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceId",
          "query": "$trace_id",
          "refId": "A"
        }
      ],
      "title": "🔎 Trace 상세 (trace_id: $trace_id)",
      "description": "선택한 Trace의 상세 Span 정보입니다. 각 Span 클릭 시 관련 로그가 아래에 표시됩니다.",
      "type": "traces"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 102,
      "panels": [],
      "title": "📝 Related Logs (관련 로그)",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 33 },
      "id": 7,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=~\"$service\"} | json | trace_id=~\"$trace_id\" | line_format \"{{.level}} [{{.source}}] {{.message}}\"",
          "refId": "A"
        }
      ],
      "title": "📋 Trace 관련 로그 (trace_id: $trace_id)",
      "description": "선택한 trace_id와 연관된 모든 로그를 시간순으로 표시합니다. trace_id 입력 후 로그가 자동으로 필터링됩니다.",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "id": 103,
      "panels": [],
      "title": "🚨 Error Logs (오류 로그)",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "filterable": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.width", "value": 180 }]
          },
          {
            "matcher": { "id": "byName", "options": "trace_id" },
            "properties": [
              { "id": "custom.width", "value": 280 },
              { "id": "links", "value": [{ "title": "View Trace in Tempo", "url": "/d/unified-view?var-trace_id=${__value.text}&${__url_time_range}" }] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "message" },
            "properties": [{ "id": "custom.width", "value": 500 }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
      "id": 8,
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" },
        "sortBy": [{ "desc": true, "displayName": "Time" }]
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=~\"$service\"} | json | level=\"ERROR\"",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "❌ 오류 로그 테이블",
      "description": "ERROR 레벨 로그를 테이블 형식으로 표시합니다. trace_id 클릭 시 해당 Trace를 위 Trace Viewer에서 확인할 수 있습니다.",
      "type": "table",
      "transformations": [
        {
          "id": "extractFields",
          "options": { "format": "json", "source": "Line" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Line": true, "labels": true, "tsNs": true },
            "indexByName": { "Time": 0, "trace_id": 1, "source": 2, "message": 3 },
            "renameByName": {}
          }
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["observability", "unified", "metrics", "traces", "logs", "self-healing"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Mimir", "value": "mimir" },
        "hide": 0,
        "includeAll": false,
        "label": "Metrics Datasource",
        "multi": false,
        "name": "metrics_datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${metrics_datasource}" },
        "definition": "label_values(http_server_request_duration_seconds_count, service_name)",
        "hide": 0,
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "options": [],
        "query": { "query": "label_values(http_server_request_duration_seconds_count, service_name)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": false, "text": "", "value": "" },
        "hide": 0,
        "label": "Trace ID",
        "name": "trace_id",
        "options": [],
        "query": "",
        "skipUrlSync": false,
        "type": "textbox",
        "description": "Trace ID를 입력하면 해당 Trace의 상세 정보와 관련 로그가 표시됩니다"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "timezone": "browser",
  "title": "Unified Observability View",
  "uid": "unified-view",
  "version": 1,
  "weekStart": ""
}
