      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "1 - (sum(rate(selfhealing_dlq_items_total[30d])) / sum(rate(selfhealing_requests_total[30d])))",
