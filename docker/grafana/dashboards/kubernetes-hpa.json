{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Kubernetes HPA 및 KEDA 기반 자동 스케일링 모니터링 대시보드",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Django API Replicas",
      "description": "Django API Pod 수 현황 및 목표",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "kube_hpa_status_current_replicas{hpa=\"django-api-hpa\"}",
          "legendFormat": "Current Replicas",
          "refId": "A"
        },
        {
          "expr": "kube_hpa_status_desired_replicas{hpa=\"django-api-hpa\"}",
          "legendFormat": "Desired Replicas",
          "refId": "B"
        },
        {
          "expr": "kube_hpa_spec_min_replicas{hpa=\"django-api-hpa\"}",
          "legendFormat": "Min Replicas",
          "refId": "C"
        },
        {
          "expr": "kube_hpa_spec_max_replicas{hpa=\"django-api-hpa\"}",
          "legendFormat": "Max Replicas",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "Pods",
            "axisPlacement": "auto",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "calcs": ["last"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "title": "Celery Worker Replicas",
      "description": "Celery Worker Pod 수 현황 (KEDA 관리)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "kube_deployment_status_replicas{deployment=~\"celery-.*-worker\"}",
          "legendFormat": "{{ deployment }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "Pods",
            "axisPlacement": "auto",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "calcs": ["last", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "title": "Redis Queue Lengths",
      "description": "Celery 큐 길이 (KEDA 스케일링 트리거)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "redis_list_length{key=~\"celery|critical|audit_flush\"}",
          "legendFormat": "{{ key }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "Tasks",
            "axisPlacement": "auto",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 100}
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "calcs": ["last", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "title": "CPU Utilization by Pod",
      "description": "Django API 및 Celery Worker CPU 사용률",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{pod=~\"django-api-.*\"}[5m])) by (pod) * 100",
          "legendFormat": "{{ pod }}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{pod=~\"celery-.*-worker-.*\"}[5m])) by (pod) * 100",
          "legendFormat": "{{ pod }}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "CPU %",
            "axisPlacement": "auto",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 90}
            ]
          },
          "unit": "percent"
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "title": "HPA Scaling Events",
      "description": "5분 동안 HPA 스케일링 이벤트 횟수",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "changes(kube_hpa_status_current_replicas{hpa=\"django-api-hpa\"}[5m])",
          "legendFormat": "Django API",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 2},
              {"color": "red", "value": 4}
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["last"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "title": "Django RPS",
      "description": "Django API 초당 요청 수",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 16
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(django_http_requests_total[2m]))",
          "legendFormat": "RPS",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 500},
              {"color": "red", "value": 1000}
            ]
          },
          "unit": "reqps"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["last"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "title": "Redis Ops/Sec",
      "description": "Redis 초당 연산 수 (KEDA 폴링 영향 모니터링)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "redis_instantaneous_ops_per_sec",
          "legendFormat": "Ops/Sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5000},
              {"color": "red", "value": 10000}
            ]
          },
          "unit": "ops"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["last"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "title": "Redis Connections",
      "description": "Redis 연결 수",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "redis_connected_clients",
          "legendFormat": "Connections",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 100},
              {"color": "red", "value": 200}
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["last"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "title": "Pod Lifetime Analysis",
      "description": "Pod 평균 생존 시간 (플래핑 감지용)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg(time() - kube_pod_start_time{pod=~\"django-api-.*\"})",
          "legendFormat": "Django API Avg Lifetime",
          "refId": "A"
        },
        {
          "expr": "avg(time() - kube_pod_start_time{pod=~\"celery-default-worker-.*\"})",
          "legendFormat": "Celery Default Avg Lifetime",
          "refId": "B"
        },
        {
          "expr": "avg(time() - kube_pod_start_time{pod=~\"celery-critical-worker-.*\"})",
          "legendFormat": "Celery Critical Avg Lifetime",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "Lifetime",
            "axisPlacement": "auto",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 60},
              {"color": "green", "value": 300}
            ]
          },
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "calcs": ["mean", "min"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 30,
  "style": "dark",
  "tags": ["kubernetes", "hpa", "keda", "autoscaling", "selfhealing"],
  "templating": {
