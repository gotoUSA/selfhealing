{
  "type": "record",
  "name": "AuditEvent",
  "namespace": "com.selfhealing.audit",
  "doc": "Self-healing 시스템 감사 이벤트 스키마",
  "fields": [
    {
      "name": "id",
      "type": "string",
      "doc": "이벤트 고유 ID (UUID)"
    },
    {
      "name": "schema_version",
      "type": "int",
      "default": 1,
      "doc": "스키마 버전"
    },
    {
      "name": "action",
      "type": "string",
      "doc": "수행된 액션 (e.g., cb_force_open, dlq_store)"
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "이벤트 발생 시간 (Unix ms)"
    },
    {
      "name": "actor_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "액터 ID (사용자 또는 시스템)"
    },
    {
      "name": "actor_type",
      "type": "string",
      "default": "system",
      "doc": "액터 유형 (user, system, service)"
    },
    {
      "name": "actor_roles",
      "type": {
        "type": "array",
        "items": "string"
      },
      "default": [],
      "doc": "액터 역할 목록"
    },
    {
      "name": "context_type",
      "type": "string",
      "default": "unknown",
      "doc": "컨텍스트 유형 (request, task, system, webhook, cli)"
    },
    {
      "name": "target_type",
      "type": ["null", "string"],
      "default": null,
      "doc": "대상 엔티티 타입 (e.g., circuit_breaker, dlq_entry)"
    },
    {
      "name": "target_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "대상 엔티티 ID"
    },
    {
      "name": "service_name",
      "type": ["null", "string"],
      "default": null,
      "doc": "서비스 이름"
    },
    {
      "name": "domain",
      "type": ["null", "string"],
      "default": null,
      "doc": "도메인 (payment, point 등)"
    },
    {
      "name": "reason",
      "type": ["null", "string"],
      "default": null,
      "doc": "이벤트 발생 사유"
    },
    {
      "name": "details",
      "type": ["null", {
        "type": "map",
        "values": "string"
      }],
      "default": null,
      "doc": "추가 상세 정보"
    },
    {
      "name": "success",
      "type": "boolean",
      "default": true,
      "doc": "작업 성공 여부"
    },
    {
      "name": "error_message",
      "type": ["null", "string"],
      "default": null,
      "doc": "에러 메시지"
    },
    {
      "name": "causation",
      "type": ["null", {
        "type": "record",
        "name": "Causation",
        "doc": "인과관계 추적 정보",
        "fields": [
          {
            "name": "cascade_id",
            "type": ["null", "string"],
            "default": null,
            "doc": "Cascade 이벤트 ID"
          },
          {
            "name": "parent_event_id",
            "type": ["null", "string"],
            "default": null,
            "doc": "부모 이벤트 ID"
          },
          {
            "name": "chain_depth",
            "type": "int",
            "default": 0,
            "doc": "체인 깊이"
          },
          {
            "name": "namespace",
            "type": "string",
            "default": "global",
            "doc": "네임스페이스"
          }
        ]
      }],
      "default": null,
      "doc": "인과관계 추적 정보"
    }
  ]
}
