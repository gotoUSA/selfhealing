{
	"info": {
		"_postman_id": "t3-journey-signup-verify-order",
		"name": "T3 Journey - Signup → Verify → Order",
		"description": "Tier 3: 회원가입 → 로그인 → 장바구니 → 주문 → 결제 전체 여정 테스트\n\n이 테스트는 인증된 사용자의 전체 구매 여정을 검증합니다.\n이메일 인증은 Tier 2에서 검증되므로, 여기서는 기존 인증된 사용자를 사용합니다.\n실패 시 경고만 기록하고 배포는 계속 진행됩니다.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Step 1: Login with Verified User",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Use existing verified test user",
							"pm.environment.set('test_username', 'test_user1');",
							"pm.environment.set('test_password', 'testpass123!');",
							"",
							"console.log('Using verified test user:', pm.environment.get('test_username'));"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Login successful - Status 200', function() {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Access token received', function() {",
							"    const response = pm.response.json();",
							"    const token = response.token ? response.token.access : (response.access || response.access_token);",
							"    pm.expect(token).to.exist;",
							"    pm.environment.set('access_token', token);",
							"});",
							"",
							"pm.test('Refresh token received (optional)', function() {",
							"    const response = pm.response.json();",
							"    const token = response.token ? response.token.refresh : (response.refresh || response.refresh_token);",
							"    // Refresh token is optional in some auth flows",
							"    if (token) {",
							"        pm.environment.set('refresh_token', token);",
							"    }",
							"    pm.expect(true).to.be.true; // Always pass",
							"});",
							"",
							"pm.test('User info returned', function() {",
							"    const response = pm.response.json();",
							"    pm.expect(response.user).to.exist;",
							"});",
							"",
							"console.log('User logged in successfully');"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"{{test_username}}\",\n    \"password\": \"{{test_password}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/auth/login/",
					"host": ["{{base_url}}"],
					"path": ["auth", "login", ""]
				}
			}
		},
		{
			"name": "Step 2: Get Available Products",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Products list retrieved - Status 200', function() {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Products exist in response', function() {",
							"    const response = pm.response.json();",
							"    const products = response.results || response;",
							"    pm.expect(products).to.be.an('array');",
							"    pm.expect(products.length).to.be.greaterThan(0);",
							"});",
							"",
							"// Select first available product with stock",
							"const response = pm.response.json();",
							"const products = response.results || response;",
							"const availableProduct = products.find(p => p.stock > 0 || p.stock_quantity > 0);",
							"",
							"if (availableProduct) {",
							"    pm.environment.set('product_id', availableProduct.id);",
							"    pm.environment.set('product_price', availableProduct.price);",
							"    pm.environment.set('product_stock_before', availableProduct.stock || availableProduct.stock_quantity);",
							"    console.log('Selected product:', availableProduct.name, 'ID:', availableProduct.id);",
							"} else {",
							"    console.error('No available products with stock found');",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/products/",
					"host": ["{{base_url}}"],
					"path": ["products", ""]
				}
			}
		},
		{
			"name": "Step 3: Add to Cart",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Verify product is selected",
							"if (!pm.environment.get('product_id')) {",
							"    console.error('No product selected - cannot add to cart');",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Item added to cart - Status 200 or 201', function() {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});",
							"",
							"pm.test('Cart item created', function() {",
							"    const response = pm.response.json();",
							"    const itemId = response.item ? response.item.id : (response.id || response.cart_item_id);",
							"    pm.expect(itemId).to.exist;",
							"    pm.environment.set('cart_item_id', itemId);",
							"});",
							"",
							"pm.test('Correct product in cart', function() {",
							"    const response = pm.response.json();",
							"    const productId = pm.environment.get('product_id');",
							"    const responseProductId = response.item ? response.item.product_id : (response.product_id || response.product);",
							"    pm.expect(String(responseProductId)).to.equal(String(productId));",
							"});",
							"",
							"console.log('Cart item created:', pm.environment.get('cart_item_id'));"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"product_id\": {{product_id}},\n    \"quantity\": 1\n}"
				},
				"url": {
					"raw": "{{base_url}}/cart/add_item/",
					"host": ["{{base_url}}"],
					"path": ["cart", "add_item", ""]
				}
			}
		},
		{
			"name": "Step 4: Check Cart Stock",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Stock check successful - Status 200', function() {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Stock is available', function() {",
							"    const response = pm.response.json();",
							"    // Check if all items are available: has_issues === false means stock is OK",
							"    const stockOk = response.has_issues === false || ",
							"                    response.all_available === true || ",
							"                    response.stock_available === true;",
							"    pm.expect(stockOk).to.be.true;",
							"});",
							"",
							"console.log('Stock check passed - ready to order');"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/cart/check_stock/",
					"host": ["{{base_url}}"],
					"path": ["cart", "check_stock", ""]
				}
			}
		},
		{
			"name": "Step 5: Create Order",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Prepare cart item IDs for order",
							"const cartItemId = pm.environment.get('cart_item_id');",
							"pm.environment.set('cart_item_ids', JSON.stringify([cartItemId]));"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Order created - Status 201 or 202', function() {",
							"    pm.expect(pm.response.code).to.be.oneOf([201, 202]);",
							"});",
							"",
							"pm.test('Order ID returned', function() {",
							"    const response = pm.response.json();",
							"    pm.expect(response.order_id || response.id).to.exist;",
							"    pm.environment.set('order_id', response.order_id || response.id);",
							"});",
							"",
							"pm.test('Order status is pending or awaiting payment', function() {",
							"    const response = pm.response.json();",
							"    const validStatuses = ['pending', 'awaiting_payment', 'created', 'PENDING'];",
							"    pm.expect(validStatuses).to.include(response.status);",
							"});",
							"",
							"console.log('Order created:', pm.environment.get('order_id'));"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"cart_item_ids\": {{cart_item_ids}},\n    \"shipping_name\": \"Test User\",\n    \"shipping_phone\": \"010-1234-5678\",\n    \"shipping_address\": \"서울시 강남구 테스트동 123\",\n    \"shipping_detail_address\": \"테스트빌딩 101호\",\n    \"shipping_postal_code\": \"12345\",\n    \"shipping_memo\": \"문 앞에 놓아주세요\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/orders/",
					"host": ["{{base_url}}"],
					"path": ["orders", ""]
				}
			}
		},
		{
			"name": "Step 6: Request Payment",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Generate idempotency key for payment",
							"const idempotencyKey = pm.variables.replaceIn('{{$guid}}');",
							"pm.environment.set('payment_idempotency_key', idempotencyKey);"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Payment request successful - Status 200 or 201', function() {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});",
							"",
							"pm.test('Payment ID returned', function() {",
							"    const response = pm.response.json();",
							"    pm.expect(response.payment_id || response.id).to.exist;",
							"    pm.environment.set('payment_id', response.payment_id || response.id);",
							"});",
							"",
							"pm.test('Order amount returned', function() {",
							"    const response = pm.response.json();",
							"    pm.expect(response.amount).to.exist;",
							"    pm.environment.set('order_amount', response.amount);",
							"});",
							"",
							"console.log('Payment requested:', pm.environment.get('payment_id'));"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					},
					{
						"key": "Idempotency-Key",
						"value": "{{payment_idempotency_key}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"order_id\": {{order_id}}\n}"
				},
				"url": {
					"raw": "{{base_url}}/payments/request/",
					"host": ["{{base_url}}"],
					"path": ["payments", "request", ""]
				}
			}
		},
		{
			"name": "Step 7: Confirm Payment",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Payment confirm accepted - Status 200 or 202', function() {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 202]);",
							"});",
							"",
							"pm.test('Payment processing or completed', function() {",
							"    const response = pm.response.json();",
							"    // 202 means async processing, 200 means immediate completion",
							"    const validStatuses = ['completed', 'paid', 'success', 'DONE', 'confirmed', 'processing', 'pending'];",
							"    pm.expect(validStatuses).to.include(response.status);",
							"});",
							"",
							"pm.test('Payment response valid', function() {",
							"    const response = pm.response.json();",
							"    // Either order_id is returned or payment is being processed",
							"    pm.expect(response.status || response.order_id || response.payment_id).to.exist;",
							"});",
							"",
							"console.log('Payment confirm processed!');"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"order_id\": {{order_id}},\n    \"payment_key\": \"{{payment_key}}\",\n    \"amount\": {{order_amount}}\n}"
				},
				"url": {
					"raw": "{{base_url}}/payments/confirm/",
					"host": ["{{base_url}}"],
					"path": ["payments", "confirm", ""]
				}
			}
		},
		{
			"name": "Step 8: Verify Order Status",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Order retrieved - Status 200', function() {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Order status is paid or processing', function() {",
							"    const response = pm.response.json();",
							"    const validStatuses = ['paid', 'processing', 'confirmed', 'PAID', 'completed'];",
							"    pm.expect(validStatuses).to.include(response.status);",
							"});",
							"",
							"pm.test('Order has valid ID', function() {",
							"    const response = pm.response.json();",
							"    pm.expect(response.id || response.order_id).to.exist;",
							"});",
							"",
							"console.log('=== JOURNEY COMPLETE ===');",
							"console.log('User:', pm.environment.get('test_username'));",
							"console.log('Order ID:', pm.environment.get('order_id'));",
							"console.log('Payment ID:', pm.environment.get('payment_id'));",
							"console.log('Status: SUCCESS');"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/orders/{{order_id}}/",
					"host": ["{{base_url}}"],
					"path": ["orders", "{{order_id}}", ""]
				}
			}
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global pre-request script",
					"console.log('=== T3 Journey: Signup → Verify → Order ===');",
					"console.log('Timestamp:', new Date().toISOString());"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global test script",
					"// Log response time for each request",
					"console.log('Response time:', pm.response.responseTime, 'ms');"
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api",
			"type": "string"
		}
	]
}
