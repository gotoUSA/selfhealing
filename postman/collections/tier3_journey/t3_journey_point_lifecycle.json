							"console.log('After Using:', pm.environment.get('points_after_using'));",
							"console.log('After Refund:', pm.environment.get('points_after_refund'));",
							"console.log('Status: POINT LIFECYCLE SUCCESS');"
						],
						"type": "text/javascript"
					}
				}
