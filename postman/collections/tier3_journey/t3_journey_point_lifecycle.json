		"name": "T3 Journey - Point Lifecycle",
		"description": "Tier 3: 포인트 적립 → 사용 → 환불 전체 라이프사이클 테스트\n\n이 테스트는 결제 시 포인트 적립, 주문 시 포인트 사용, 취소 시 포인트 환불이 정확하게 처리되는지 검증합니다.\n실패 시 경고만 기록하고 배포는 계속 진행됩니다.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Step 1: Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Login successful - Status 200', function() {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Access token received', function() {",
							"    const response = pm.response.json();",
							"    const accessToken = response.token?.access || response.access || response.access_token;",
							"    pm.expect(accessToken).to.exist;",
							"    pm.environment.set('access_token', accessToken);",
							"});",
							"",
							"pm.test('Refresh token received (optional)', function() {",
							"    const response = pm.response.json();",
							"    const refreshToken = response.token?.refresh || response.refresh || response.refresh_token;",
							"    if (refreshToken) {",
							"        pm.environment.set('refresh_token', refreshToken);",
							"    } else {",
							"        console.log('Note: API does not return refresh token');",
							"    }",
							"});",
							"",
							"const response = pm.response.json();",
							"if (response.user_id || response.user) {",
							"    pm.environment.set('user_id', response.user_id || response.user);",
							"}",
							"",
							"console.log('User logged in successfully');"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"{{test_username}}\",\n    \"password\": \"{{test_password}}\"\n}"
				},
