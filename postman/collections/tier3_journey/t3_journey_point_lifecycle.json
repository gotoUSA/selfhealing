							"pm.test('Points increased after payment (earned)', function() {",
							"    pm.expect(currentPoints).to.be.at.least(initialPoints);",
							"});",
							"",
							"const earnedPoints = currentPoints - initialPoints;",
							"pm.environment.set('earned_points', earnedPoints);",
							"",
							"console.log('=== AFTER EARNING ===');",
							"console.log('Initial Points:', initialPoints);",
							"console.log('Current Points:', currentPoints);",
							"console.log('Earned Points:', earnedPoints);"
