					"script": {
						"exec": [
							"pm.test('Points retrieved - Status 200', function() {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"const response = pm.response.json();",
							"const initialPoints = parseInt(pm.environment.get('initial_points'));",
							"const currentPoints = response.points || response.balance || response.total || 0;",
							"",
							"pm.environment.set('points_after_earning', currentPoints);",
