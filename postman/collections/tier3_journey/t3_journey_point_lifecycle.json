		{
			"name": "Step 6: Request First Payment",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const idempotencyKey = pm.variables.replaceIn('{{$guid}}');",
							"pm.environment.set('idempotency_key_1', idempotencyKey);",
							"",
							"// Wait for async order processing",
							"const orderId = pm.environment.get('order_id_1');",
							"const accessToken = pm.environment.get('access_token');",
							"const baseUrl = pm.environment.get('base_url');",
							"",
							"// Poll order status to ensure it's ready for payment",
							"const maxRetries = 5;",
							"let retryCount = 0;",
							"",
							"function checkOrderStatus(callback) {",
							"    pm.sendRequest({",
							"        url: baseUrl + '/orders/' + orderId + '/',",
							"        method: 'GET',",
							"        header: {",
							"            'Authorization': 'Bearer ' + accessToken",
							"        }",
							"    }, function(err, response) {",
							"        if (!err && response.code === 200) {",
							"            console.log('Order is ready for payment');",
							"            callback();",
							"        } else if (retryCount < maxRetries) {",
							"            retryCount++;",
							"            console.log('Waiting for order processing... attempt ' + retryCount);",
							"            setTimeout(() => checkOrderStatus(callback), 1000);",
							"        } else {",
							"            console.log('Order may still be processing, proceeding anyway');",
							"            callback();",
							"        }",
							"    });",
							"}",
							"",
							"checkOrderStatus(() => { console.log('Ready to request payment'); });"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Payment request successful - Status 200 or 201', function() {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});",
							"",
							"pm.test('Payment ID returned', function() {",
							"    const response = pm.response.json();",
							"    pm.expect(response.payment_id || response.id).to.exist;",
							"    pm.environment.set('payment_id_1', response.payment_id || response.id);",
							"});",
							"",
							"const response = pm.response.json();",
							"if (response.payment_key) {",
							"    pm.environment.set('payment_key_1', response.payment_key);",
							"}",
							"if (response.amount) {",
							"    pm.environment.set('order_amount_1', response.amount);",
							"}",
							"",
							"console.log('First payment requested:', pm.environment.get('payment_id_1'), 'Amount:', pm.environment.get('order_amount_1'));"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					},
					{
						"key": "Idempotency-Key",
						"value": "{{idempotency_key_1}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"order_id\": {{order_id_1}}\n}"
				},
				"url": {
					"raw": "{{base_url}}/payments/request/",
					"host": ["{{base_url}}"],
					"path": ["payments", "request", ""]
				}
			}
