						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"product_id\": {{product_id}},\n    \"quantity\": 1\n}"
				},
				"url": {
					"raw": "{{base_url}}/cart/add_item/",
					"host": ["{{base_url}}"],
					"path": ["cart", "add_item", ""]
				}
