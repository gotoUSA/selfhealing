							"});",
							"",
							"pm.test('Reorder is different from original order', function() {",
							"    const reorderId = pm.environment.get('reorder_id');",
							"    const originalOrderId = pm.environment.get('order_id');",
							"    pm.expect(String(reorderId)).to.not.equal(String(originalOrderId));",
							"});",
							"",
							"console.log('=== JOURNEY COMPLETE ===');",
							"console.log('Original Order ID:', pm.environment.get('order_id'), '- CANCELLED');",
							"console.log('Reorder ID:', pm.environment.get('reorder_id'), '- PAID');",
							"console.log('Status: REORDER SUCCESS');"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/orders/{{reorder_id}}/",
					"host": ["{{base_url}}"],
					"path": ["orders", "{{reorder_id}}", ""]
				}
			}
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global pre-request script",
