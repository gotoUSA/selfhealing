{
	"info": {
		"_postman_id": "t3-journey-purchase-cancel-reorder",
		"name": "T3 Journey - Purchase → Cancel → Reorder",
		"description": "Tier 3: 구매 → 취소 → 재구매 전체 여정 테스트\n\n이 테스트는 사용자가 상품을 구매하고, 결제를 취소한 후 동일 상품을 재구매할 수 있는지 검증합니다.\n실패 시 경고만 기록하고 배포는 계속 진행됩니다.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Step 1: Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Login successful - Status 200', function() {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Access token received', function() {",
							"    const response = pm.response.json();",
							"    pm.expect(response.access || response.access_token).to.exist;",
							"    pm.environment.set('access_token', response.access || response.access_token);",
							"});",
							"",
							"pm.test('Refresh token received', function() {",
							"    const response = pm.response.json();",
							"    pm.expect(response.refresh || response.refresh_token).to.exist;",
							"    pm.environment.set('refresh_token', response.refresh || response.refresh_token);",
							"});",
							"",
							"// Store user ID if returned",
							"const response = pm.response.json();",
							"if (response.user_id || response.user) {",
							"    pm.environment.set('user_id', response.user_id || response.user);",
							"}",
							"",
							"console.log('User logged in successfully');"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"{{test_username}}\",\n    \"password\": \"{{test_password}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/auth/login/",
					"host": ["{{base_url}}"],
					"path": ["auth", "login", ""]
				}
			}
		},
		{
			"name": "Step 2: Get Product (Before State)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Product retrieved - Status 200', function() {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"const response = pm.response.json();",
							"",
							"// Save before state",
							"pm.environment.set('product_id', response.id);",
							"pm.environment.set('product_stock_before', response.stock || response.quantity);",
							"pm.environment.set('product_sold_before', response.sold || 0);",
							"pm.environment.set('product_price', response.price);",
							"",
							"pm.test('Product has stock available', function() {",
							"    const stock = response.stock || response.quantity;",
							"    pm.expect(stock).to.be.greaterThan(0);",
							"});",
							"",
							"console.log('Before State - Stock:', pm.environment.get('product_stock_before'));",
							"console.log('Before State - Sold:', pm.environment.get('product_sold_before'));"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{access_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/products/{{product_id}}/",
					"host": ["{{base_url}}"],
					"path": ["products", "{{product_id}}", ""]
				}
			}
		},
