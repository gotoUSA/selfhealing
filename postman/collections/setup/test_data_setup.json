{
  "info": {
    "_postman_id": "test-data-setup",
    "name": "Test Data Setup",
    "description": "테스트 환경 초기화 및 테스트 사용자 생성\n\n## 목적\n- verified_user: 인증 완료된 정상 사용자 (Tier 1/3 테스트용)\n- unverified_user: 이메일 미인증 사용자 (Tier 2 보안 테스트용)\n- admin_user: 관리자 권한 테스트용 (선택)\n\n## 사용법\n- 테스트 실행 전 이 Collection을 먼저 실행\n- 생성된 사용자 정보는 환경변수에 자동 저장\n\n## CI 정책\n- 이 Collection 실패 시 후속 테스트 중단",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('API Server is running', function() {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 301, 302]);",
              "    console.log('✓ API Server is healthy');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health/",
          "host": ["{{base_url}}"],
          "path": ["health", ""]
        }
      }
    },
    {
      "name": "1. Create Verified User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// 재현 가능한 테스트 데이터 생성 (timestamp 기반)",
              "const timestamp = Date.now();",
              "const testUsername = `testuser_${timestamp}`;",
              "const testEmail = `testuser_${timestamp}@test.example.com`;",
              "const testPassword = 'TestPass123!@#';",
              "",
              "pm.environment.set('new_verified_username', testUsername);",
              "pm.environment.set('new_verified_email', testEmail);",
              "pm.environment.set('new_verified_password', testPassword);",
              "",
              "console.log('========================================');",
              "console.log('Creating Verified User:');",
              "console.log('  Username:', testUsername);",
              "console.log('  Email:', testEmail);",
              "console.log('========================================');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Verified user created or exists', function() {",
              "    // 201: 새로 생성됨, 200: 이미 존재, 400: 중복 (재실행 시)",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400]);",
              "    ",
              "    if (pm.response.code === 201 || pm.response.code === 200) {",
              "        var jsonData = pm.response.json();",
              "        if (jsonData.id || jsonData.user_id) {",
              "            pm.environment.set('verified_user_id', jsonData.id || jsonData.user_id);",
              "        }",
              "        console.log('✓ Verified user created/exists');",
              "    } else {",
              "        console.log('⚠ User may already exist (400 response)');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{new_verified_username}}\",\n    \"email\": \"{{new_verified_email}}\",\n    \"password\": \"{{new_verified_password}}\",\n    \"password_confirm\": \"{{new_verified_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/register/",
          "host": ["{{base_url}}"],
          "path": ["auth", "register", ""]
        }
      }
    },
    {
      "name": "2. Verify User Email (Force)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('User email verified', function() {",
              "    // 테스트 환경에서는 강제 인증 API 사용",
              "    // 또는 DB 직접 업데이트 필요할 수 있음",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204, 404]);",
              "    ",
              "    if (pm.response.code === 200 || pm.response.code === 204) {",
              "        console.log('✓ User email verified');",
              "        ",
              "        // 인증 완료된 사용자 정보를 테스트용 환경변수로 저장",
              "        pm.environment.set('test_username', pm.environment.get('new_verified_username'));",
              "        pm.environment.set('test_password', pm.environment.get('new_verified_password'));",
              "        pm.environment.set('test_email', pm.environment.get('new_verified_email'));",
              "    } else {",
              "        console.log('⚠ Force verify API not available - using existing test user');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"{{new_verified_email}}\",\n    \"force_verify\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/force-verify/",
          "host": ["{{base_url}}"],
          "path": ["auth", "force-verify", ""]
        }
      }
    },
    {
      "name": "3. Login Verified User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Verified user can login', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    pm.expect(jsonData.token).to.exist;",
              "    pm.expect(jsonData.token.access).to.exist;",
              "    pm.expect(typeof jsonData.token.access).to.eql('string');",
              "    ",
              "    pm.environment.set('access_token', jsonData.token.access);",
              "    if (jsonData.token.refresh) {",
              "        pm.environment.set('refresh_token', jsonData.token.refresh);",
              "    }",
              "    ",
              "    console.log('✓ Verified user logged in successfully');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{test_username}}\",\n    \"password\": \"{{test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login/",
          "host": ["{{base_url}}"],
          "path": ["auth", "login", ""]
        }
      }
    },
    {
      "name": "4. Create Unverified User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// 미인증 사용자 생성 (보안 테스트용)",
              "const timestamp = Date.now();",
              "const unverifiedUsername = `unverified_${timestamp}`;",
              "const unverifiedEmail = `unverified_${timestamp}@test.example.com`;",
              "const unverifiedPassword = 'UnverifiedPass123!@#';",
              "",
              "pm.environment.set('unverified_username', unverifiedUsername);",
              "pm.environment.set('unverified_email', unverifiedEmail);",
              "pm.environment.set('unverified_password', unverifiedPassword);",
              "",
              "console.log('========================================');",
              "console.log('Creating Unverified User (Security Test):');",
              "console.log('  Username:', unverifiedUsername);",
              "console.log('  Email:', unverifiedEmail);",
              "console.log('========================================');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Unverified user created', function() {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400]);",
              "    ",
              "    if (pm.response.code === 201 || pm.response.code === 200) {",
              "        var jsonData = pm.response.json();",
              "        if (jsonData.id || jsonData.user_id) {",
              "            pm.environment.set('unverified_user_id', jsonData.id || jsonData.user_id);",
              "        }",
              "        console.log('✓ Unverified user created (email NOT verified)');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{unverified_username}}\",\n    \"email\": \"{{unverified_email}}\",\n    \"password\": \"{{unverified_password}}\",\n    \"password_confirm\": \"{{unverified_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/register/",
          "host": ["{{base_url}}"],
          "path": ["auth", "register", ""]
        }
      }
    },
    {
      "name": "5. Verify Unverified User Cannot Login (Security)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Unverified user login blocked', function() {",
              "    // 미인증 사용자는 로그인 거부되어야 함",
              "    // 401 Unauthorized 또는 403 Forbidden 또는 400 Bad Request",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 401, 403]);",
              "    ",
              "    var jsonData = pm.response.json();",
              "    ",
              "    // 에러 메시지에 'verify', 'email', 'confirm' 등의 키워드 확인",
              "    var responseText = JSON.stringify(jsonData).toLowerCase();",
              "    var hasVerifyMessage = responseText.includes('verify') || ",
              "                           responseText.includes('confirm') || ",
              "                           responseText.includes('email') ||",
              "                           responseText.includes('인증');",
              "    ",
              "    console.log('✓ Unverified user correctly blocked from login');",
              "    console.log('  Response:', JSON.stringify(jsonData));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{unverified_username}}\",\n    \"password\": \"{{unverified_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login/",
          "host": ["{{base_url}}"],
          "path": ["auth", "login", ""]
        }
      }
    },
    {
      "name": "6. Get Test Product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Test product available', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    // 리스트 응답인 경우",
              "    var products = jsonData.results || jsonData;",
              "    pm.expect(products.length).to.be.above(0);",
              "    ",
              "    var product = products[0];",
              "    pm.environment.set('product_id', product.id);",
              "    pm.environment.set('product_price', product.price);",
              "    pm.environment.set('product_stock', product.stock);",
              "    ",
              "    console.log('✓ Test product found:');",
              "    console.log('  ID:', product.id);",
              "    console.log('  Price:', product.price);",
              "    console.log('  Stock:', product.stock);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/products/?limit=1",
          "host": ["{{base_url}}"],
          "path": ["products", ""],
          "query": [
            {
              "key": "limit",
              "value": "1"
            }
          ]
        }
      }
    },
    {
      "name": "7. Summary",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "console.log('');",
              "console.log('========================================');",
              "console.log('  TEST DATA SETUP COMPLETE');",
              "console.log('========================================');",
              "console.log('');",
              "console.log('Verified User:');",
              "console.log('  Username:', pm.environment.get('test_username'));",
              "console.log('  Email:', pm.environment.get('test_email'));",
              "console.log('');",
              "console.log('Unverified User (Security Test):');",
              "console.log('  Username:', pm.environment.get('unverified_username'));",
              "console.log('  Email:', pm.environment.get('unverified_email'));",
              "console.log('');",
              "console.log('Test Product:');",
              "console.log('  ID:', pm.environment.get('product_id'));",
              "console.log('  Price:', pm.environment.get('product_price'));",
              "console.log('');",
              "console.log('Access Token: (saved in environment)');",
              "console.log('========================================');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Setup summary', function() {",
              "    // 필수 환경변수 확인",
              "    pm.expect(pm.environment.get('test_username')).to.exist;",
              "    pm.expect(pm.environment.get('access_token')).to.exist;",
              "    pm.expect(pm.environment.get('product_id')).to.exist;",
              "    ",
              "    console.log('✓ All required test data is ready');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health/",
          "host": ["{{base_url}}"],
          "path": ["health", ""]
        }
      }
    }
  ]
}
