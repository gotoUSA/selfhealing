{
  "info": {
    "_postman_id": "t1-payment-cancel-earned-deduct",
    "name": "T1_Payment_Cancel_EarnedDeduct",
    "description": "결제 취소 시 적립된 포인트가 정확히 회수되는지 검증\n\n## 목적\n- 결제 완료 시 적립된 포인트가 취소 시 회수되는지 확인\n- user.points -= earned_points\n\n## 검증 포인트\n- 취소 후 포인트 = 취소 전 포인트 - 적립된 포인트\n- 적립 포인트가 정확히 차감되어야 함\n\n## CI 정책\n- 실패 시 배포 중단 (Tier 1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Step 1: Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login successful', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.token).to.exist;",
              "    pm.expect(jsonData.token.access).to.exist;",
              "    pm.environment.set('access_token', jsonData.token.access);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{test_username}}\",\n    \"password\": \"{{test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login/",
          "host": ["{{base_url}}"],
          "path": ["auth", "login", ""]
        }
      }
    },
    {
      "name": "Step 2: Get Initial Points (Precondition)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Initial points retrieved successfully', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    var currentPoints = jsonData.points || jsonData.balance || 0;",
              "    pm.environment.set('initial_points', currentPoints);",
              "    ",
              "    console.log('========================================');",
              "    console.log('PRECONDITION - Initial State:');",
              "    console.log('  Current Points:', currentPoints);",
              "    console.log('========================================');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/points/my/",
          "host": ["{{base_url}}"],
          "path": ["points", "my", ""]
        }
      }
    },
    {
      "name": "Step 3: Get Product Info",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Product retrieved', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('product_price', jsonData.price);",
              "    pm.environment.set('product_stock', jsonData.stock);",
              "    ",
              "    console.log('Product Info:');",
              "    console.log('  Price:', jsonData.price);",
              "    console.log('  Stock:', jsonData.stock);",
              "});"
