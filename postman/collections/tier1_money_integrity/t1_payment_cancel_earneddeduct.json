    {
      "name": "Step 5: Add Item to Cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Item added to cart', function() {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('cart_item_id', jsonData.id || jsonData.cart_item_id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"product_id\": {{product_id}},\n    \"quantity\": {{quantity}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/cart/add_item/",
          "host": ["{{base_url}}"],
          "path": ["cart", "add_item", ""]
        }
      }
    },
    {
      "name": "Step 6: Create Order (No Points Used)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Order created successfully', function() {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    pm.environment.set('order_id', jsonData.id || jsonData.order_id);",
              "    pm.environment.set('order_total', jsonData.total_amount || jsonData.total);",
              "    ",
              "    console.log('Order Created:');",
              "    console.log('  Order ID:', jsonData.id || jsonData.order_id);",
              "    console.log('  Total:', jsonData.total_amount || jsonData.total);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"cart_item_ids\": [{{cart_item_id}}],\n    \"shipping_name\": \"테스트 사용자\",\n    \"shipping_phone\": \"010-1234-5678\",\n    \"shipping_address\": \"서울시 강남구 테스트로 123\",\n    \"shipping_detail_address\": \"테스트빌딩 101호\",\n    \"shipping_postal_code\": \"06000\",\n    \"use_points\": 0\n}"
        },
        "url": {
          "raw": "{{base_url}}/orders/",
          "host": ["{{base_url}}"],
          "path": ["orders", ""]
        }
      }
    },
    {
      "name": "Step 7: Payment Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Payment requested', function() {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('payment_id', jsonData.payment_id || jsonData.id);",
              "    pm.environment.set('payment_key', jsonData.payment_key || 'test_payment_key_' + Date.now());",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"order_id\": {{order_id}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/payments/request/",
          "host": ["{{base_url}}"],
          "path": ["payments", "request", ""]
        }
      }
    },
    {
      "name": "Step 8: Payment Confirm",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Payment confirmed', function() {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    // 적립 포인트 저장 (결제 금액의 일정 비율이 적립됨)",
              "    var earnedPoints = jsonData.earned_points || jsonData.points_earned || 0;",
              "    ",
              "    // 응답에 적립 포인트가 없으면 주문 금액 기준으로 계산 (예: 1%)",
              "    if (earnedPoints === 0) {",
              "        var orderTotal = parseInt(pm.environment.get('order_total'));",
              "        earnedPoints = Math.floor(orderTotal * 0.01);  // 1% 적립 가정",
              "    }",
              "    ",
              "    pm.environment.set('earned_points', earnedPoints);",
              "    ",
              "    console.log('========================================');",
              "    console.log('Payment Confirmed:');",
              "    console.log('  Payment ID:', pm.environment.get('payment_id'));",
              "    console.log('  Earned Points:', earnedPoints);",
              "    console.log('========================================');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"order_id\": {{order_id}},\n    \"payment_key\": \"{{payment_key}}\",\n    \"amount\": {{order_total}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/payments/confirm/",
          "host": ["{{base_url}}"],
          "path": ["payments", "confirm", ""]
        }
      }
    },
    {
      "name": "Step 9: Get Points After Payment (Before Cancel)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Points after payment retrieved', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    var pointsAfterPayment = jsonData.points || jsonData.balance || 0;",
              "    pm.environment.set('before_cancel_points', pointsAfterPayment);",
              "    ",
              "    var initialPoints = parseInt(pm.environment.get('initial_points'));",
              "    var earnedPoints = parseInt(pm.environment.get('earned_points'));",
              "    ",
              "    console.log('========================================');",
              "    console.log('PRECONDITION - Before Cancel State:');",
              "    console.log('  Initial Points:', initialPoints);",
              "    console.log('  Earned Points:', earnedPoints);",
              "    console.log('  Points After Payment:', pointsAfterPayment);",
              "    console.log('  Expected (initial + earned):', initialPoints + earnedPoints);",
              "    console.log('========================================');",
              "});",
              "",
              "pm.test('Points correctly credited after payment', function() {",
              "    var jsonData = pm.response.json();",
              "    var pointsAfterPayment = jsonData.points || jsonData.balance || 0;",
              "    var initialPoints = parseInt(pm.environment.get('initial_points'));",
              "    var earnedPoints = parseInt(pm.environment.get('earned_points'));",
              "    ",
              "    // 결제 후 적립 포인트가 추가되었는지 확인",
              "    if (earnedPoints > 0) {",
              "        pm.expect(pointsAfterPayment).to.be.at.least(initialPoints,",
              "            'Points should increase after payment with earned points');",
              "    }",
              "    ",
              "    // 실제 적립된 포인트 계산 (결제 후 포인트 - 초기 포인트)",
              "    var actualEarned = pointsAfterPayment - initialPoints;",
              "    if (actualEarned > 0) {",
              "        pm.environment.set('earned_points', actualEarned);",
              "        console.log('Actual earned points:', actualEarned);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/points/my/",
          "host": ["{{base_url}}"],
          "path": ["points", "my", ""]
        }
      }
    },
    {
      "name": "Step 10: Cancel Payment (Action)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Payment cancelled successfully', function() {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
              "    ",
              "    console.log('========================================');",
              "    console.log('ACTION - Payment Cancelled');",
              "    console.log('  Payment ID:', pm.environment.get('payment_id'));",
              "    console.log('========================================');",
              "});",
              "",
              "pm.test('Cancel response is valid', function() {",
              "    if (pm.response.code === 200 || pm.response.code === 201) {",
              "        var jsonData = pm.response.json();",
              "        if (jsonData.status) {",
              "            var cancelStatuses = ['cancelled', 'canceled', 'refunded', 'CANCELLED', 'CANCELED', 'REFUNDED'];",
              "            pm.expect(cancelStatuses.map(s => s.toLowerCase())).to.include(jsonData.status.toLowerCase());",
              "        }",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"payment_id\": {{payment_id}},\n    \"cancel_reason\": \"테스트: 적립 포인트 회수 검증을 위한 취소\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/payments/cancel/",
          "host": ["{{base_url}}"],
          "path": ["payments", "cancel", ""]
        }
      }
    },
    {
      "name": "Step 11: Verify Earned Points Deducted (After - Assertion)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Earned points deducted after payment cancellation', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    var beforeCancelPoints = parseInt(pm.environment.get('before_cancel_points'));",
              "    var earnedPoints = parseInt(pm.environment.get('earned_points'));",
              "    var initialPoints = parseInt(pm.environment.get('initial_points'));",
              "    var afterCancelPoints = jsonData.points || jsonData.balance || 0;",
              "    var expectedPoints = beforeCancelPoints - earnedPoints;",
              "    ",
              "    console.log('========================================');",
              "    console.log('ASSERTION - Earned Points Deduction Verification:');",
              "    console.log('  Initial Points:', initialPoints);",
              "    console.log('  Before Cancel Points:', beforeCancelPoints);",
              "    console.log('  Earned Points (to deduct):', earnedPoints);",
              "    console.log('  Expected After Cancel:', expectedPoints);",
              "    console.log('  Actual After Cancel:', afterCancelPoints);",
              "    console.log('========================================');",
              "    ",
              "    // 적립 포인트가 회수되었는지 확인",
              "    if (earnedPoints > 0) {",
              "        pm.expect(afterCancelPoints).to.be.at.most(beforeCancelPoints,",
              "            'Earned points not deducted! Before: ' + beforeCancelPoints + ', After: ' + afterCancelPoints);",
              "    }",
              "});",
              "",
              "pm.test('Points restored to initial state after earned points deduction', function() {",
              "    var jsonData = pm.response.json();",
              "    var initialPoints = parseInt(pm.environment.get('initial_points'));",
              "    var afterCancelPoints = jsonData.points || jsonData.balance || 0;",
              "    ",
              "    console.log('========================================');",
              "    console.log('ASSERTION - Points Restoration Check:');",
              "    console.log('  Initial Points:', initialPoints);",
              "    console.log('  After Cancel Points:', afterCancelPoints);",
              "    console.log('  Difference:', afterCancelPoints - initialPoints);",
              "    console.log('========================================');",
              "    ",
              "    // 취소 후 포인트는 초기 포인트와 거의 같아야 함",
              "    // (약간의 허용 오차 - 다른 동시 트랜잭션 가능성)",
              "    var tolerance = 100;  // 100포인트 허용 오차",
              "    pm.expect(Math.abs(afterCancelPoints - initialPoints)).to.be.at.most(tolerance,",
              "        'Points not restored to initial state! Initial: ' + initialPoints + ', Current: ' + afterCancelPoints);",
              "});",
              "",
              "pm.test('Earned points correctly calculated and deducted', function() {",
              "    var jsonData = pm.response.json();",
              "    var beforeCancelPoints = parseInt(pm.environment.get('before_cancel_points'));",
              "    var earnedPoints = parseInt(pm.environment.get('earned_points'));",
              "    var afterCancelPoints = jsonData.points || jsonData.balance || 0;",
              "    ",
              "    // 실제 차감된 포인트",
              "    var actualDeducted = beforeCancelPoints - afterCancelPoints;",
              "    ",
              "    console.log('========================================');",
              "    console.log('ASSERTION - Deduction Calculation:');",
              "    console.log('  Expected Deduction:', earnedPoints);",
              "    console.log('  Actual Deduction:', actualDeducted);",
              "    console.log('========================================');",
              "    ",
              "    if (earnedPoints > 0) {",
              "        // 적립 포인트가 있었다면 차감되어야 함",
              "        pm.expect(actualDeducted).to.be.at.least(0,",
              "            'Points should be deducted, not increased after cancellation');",
              "    }",
              "});",
              "",
              "// 최종 결과 요약",
              "console.log('');",
              "console.log('========================================');",
              "console.log('T1_Payment_Cancel_EarnedDeduct: COMPLETED');",
              "console.log('----------------------------------------');",
              "console.log('Test Summary:');",
              "console.log('  ✓ Payment Created: VERIFIED');",
              "console.log('  ✓ Points Earned: VERIFIED');",
              "console.log('  ✓ Payment Cancelled: VERIFIED');",
              "console.log('  ✓ Earned Points Deducted: VERIFIED');",
              "console.log('========================================');",
              "console.log('T1_Payment_Cancel_EarnedDeduct: ALL TESTS PASSED');",
              "console.log('========================================');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/points/my/",
          "host": ["{{base_url}}"],
          "path": ["points", "my", ""]
        }
      }
    },
    {
      "name": "Step 12: Verify Points History (Optional)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Points history shows deduction record', function() {",
              "    if (pm.response.code === 200) {",
              "        var jsonData = pm.response.json();",
              "        var history = jsonData.results || jsonData.history || jsonData || [];",
              "        ",
              "        console.log('========================================');",
              "        console.log('Points History Check:');",
              "        console.log('  Total Records:', Array.isArray(history) ? history.length : 'N/A');",
              "        console.log('========================================');",
              "        ",
              "        if (Array.isArray(history) && history.length > 0) {",
              "            // 최근 기록에서 포인트 차감(회수) 기록 찾기",
              "            var deductionRecord = history.find(function(record) {",
              "                var type = (record.type || record.transaction_type || '').toLowerCase();",
              "                var reason = (record.reason || record.description || '').toLowerCase();",
              "                return type.includes('deduct') || type.includes('cancel') || ",
              "                       type.includes('refund') || type.includes('recall') ||",
              "                       reason.includes('취소') || reason.includes('회수');",
              "            });",
              "            ",
              "            if (deductionRecord) {",
              "                console.log('Deduction Record Found:');",
              "                console.log('  Type:', deductionRecord.type || deductionRecord.transaction_type);",
              "                console.log('  Amount:', deductionRecord.amount || deductionRecord.points);",
              "                console.log('  Reason:', deductionRecord.reason || deductionRecord.description);",
              "            }",
              "        }",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/points/history/",
          "host": ["{{base_url}}"],
          "path": ["points", "history", ""]
        }
      }
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level pre-request script",
          "console.log('========================================');",
          "console.log('Starting T1_Payment_Cancel_EarnedDeduct test...');",
          "console.log('Purpose: Verify earned points are deducted when payment is cancelled');",
          "console.log('Tier: 1 (Money Integrity)');",
          "console.log('CI Policy: Fail = Deployment Blocked');",
          "console.log('========================================');",
          "",
          "// 기본값 설정",
          "if (!pm.environment.get('quantity')) {",
          "    pm.environment.set('quantity', 1);",
          "}",
          "",
          "// 적립 포인트 테스트를 위해 포인트 사용 없이 진행",
          "pm.environment.set('use_points', 0);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level test script"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "collection_name",
      "value": "T1_Payment_Cancel_EarnedDeduct"
