    {
      "name": "Step 5: Add Item to Cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Item added to cart', function() {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('cart_item_id', jsonData.id || jsonData.cart_item_id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"product_id\": {{product_id}},\n    \"quantity\": {{quantity}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/cart/add_item/",
          "host": ["{{base_url}}"],
          "path": ["cart", "add_item", ""]
        }
      }
    },
    {
      "name": "Step 6: Create Order",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Order created successfully', function() {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    pm.environment.set('order_id', jsonData.order_id || jsonData.id);",
              "    pm.environment.set('correct_amount', jsonData.final_amount || jsonData.total_amount || jsonData.total);",
              "    ",
              "    // 잘못된 금액 설정 (올바른 금액보다 낮은 금액)",
              "    var correctAmount = parseInt(jsonData.final_amount || jsonData.total_amount || jsonData.total || 10000);",
              "    var wrongAmount = Math.floor(correctAmount * 0.5);  // 50% 금액",
              "    pm.environment.set('wrong_amount', wrongAmount);",
              "    ",
              "    console.log('========================================');",
              "    console.log('Order Created:');",
              "    console.log('  Order ID:', jsonData.order_id || jsonData.id);",
              "    console.log('  Correct Amount:', correctAmount);",
              "    console.log('  Wrong Amount (for test):', wrongAmount);",
              "    console.log('========================================');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"cart_item_ids\": [{{cart_item_id}}],\n    \"shipping_name\": \"테스트 사용자\",\n    \"shipping_phone\": \"010-1234-5678\",\n    \"shipping_address\": \"서울시 강남구 테스트로 123\",\n    \"shipping_detail_address\": \"테스트빌딩 101호\",\n    \"shipping_postal_code\": \"06000\",\n    \"use_points\": 0\n}"
        },
        "url": {
          "raw": "{{base_url}}/orders/",
          "host": ["{{base_url}}"],
          "path": ["orders", ""]
        }
      }
    },
    {
      "name": "Step 6.5: Wait and Get Order Details",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// 비동기 처리 완료 대기",
              "setTimeout(function() {}, 1000);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Order details retrieved', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    pm.environment.set('correct_amount', jsonData.final_amount || jsonData.total_amount);",
              "    var correctAmount = parseInt(jsonData.final_amount || jsonData.total_amount);",
              "    var wrongAmount = Math.floor(correctAmount * 0.5);",
              "    pm.environment.set('wrong_amount', wrongAmount);",
              "    ",
              "    console.log('========================================');",
              "    console.log('Order Details:');",
              "    console.log('  Order ID:', pm.environment.get('order_id'));",
              "    console.log('  Final Amount:', correctAmount);",
              "    console.log('  Wrong Amount (for test):', wrongAmount);",
              "    console.log('========================================');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/orders/{{order_id}}/",
          "host": ["{{base_url}}"],
          "path": ["orders", "{{order_id}}", ""]
        }
      }
    },
    {
      "name": "Step 7: Payment Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Payment requested', function() {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('payment_id', jsonData.payment_id || jsonData.id);",
              "    pm.environment.set('payment_key', jsonData.payment_key || 'test_payment_key_' + Date.now());",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"order_id\": {{order_id}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/payments/request/",
          "host": ["{{base_url}}"],
          "path": ["payments", "request", ""]
        }
      }
    },
    {
      "name": "Step 8: Payment Confirm with WRONG Amount (Action)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Payment with wrong amount is REJECTED', function() {",
              "    // 금액 불일치 시 400, 422, 또는 다른 에러 코드 반환 예상",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 401, 402, 403, 422, 409, 500]);",
              "    ",
              "    console.log('========================================');",
              "    console.log('ACTION - Payment with Wrong Amount:');",
              "    console.log('  Correct Amount:', pm.environment.get('correct_amount'));",
              "    console.log('  Submitted Amount:', pm.environment.get('wrong_amount'));",
              "    console.log('  Response Status:', pm.response.code);",
              "    console.log('========================================');",
              "});",
              "",
              "pm.test('Error response contains amount mismatch indication', function() {",
              "    var jsonData = pm.response.json();",
              "    var responseText = JSON.stringify(jsonData).toLowerCase();",
              "    ",
              "    // 에러 메시지에 금액 관련 내용이 있는지 확인",
              "    var hasAmountError = responseText.includes('amount') ||",
              "                         responseText.includes('mismatch') ||",
              "                         responseText.includes('금액') ||",
              "                         responseText.includes('불일치') ||",
              "                         responseText.includes('invalid') ||",
              "                         responseText.includes('error');",
              "    ",
              "    console.log('Error Response:', JSON.stringify(jsonData));",
              "    ",
              "    // 에러 응답이 있음을 확인",
              "    pm.expect(jsonData.error || jsonData.message || jsonData.detail || jsonData.non_field_errors).to.exist;",
              "});",
              "",
              "pm.test('Payment NOT processed with wrong amount', function() {",
              "    // 200/201이 아니면 결제가 처리되지 않음",
              "    pm.expect(pm.response.code).to.not.be.oneOf([200, 201]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"order_id\": {{order_id}},\n    \"payment_key\": \"{{payment_key}}\",\n    \"amount\": {{wrong_amount}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/payments/confirm/",
          "host": ["{{base_url}}"],
          "path": ["payments", "confirm", ""]
        }
      }
    },
    {
      "name": "Step 9: Verify Stock Unchanged (Assertion)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Stock unchanged after failed payment', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    var initialStock = parseInt(pm.environment.get('initial_stock'));",
              "    var currentStock = jsonData.stock;",
              "    ",
              "    console.log('========================================');",
              "    console.log('ASSERTION - Stock Verification:');",
              "    console.log('  Initial Stock:', initialStock);",
              "    console.log('  Current Stock:', currentStock);",
              "    console.log('========================================');",
              "    ",
              "    // 재고 변동 없어야 함 (주문 생성 시 예약된 경우 제외)",
              "    pm.expect(currentStock).to.be.at.least(initialStock - parseInt(pm.environment.get('quantity') || 1),",
              "        'Stock should not be permanently reduced after failed payment');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/products/{{product_id}}/",
          "host": ["{{base_url}}"],
          "path": ["products", "{{product_id}}", ""]
        }
      }
    },
    {
      "name": "Step 10: Verify Points Unchanged (Assertion)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Points unchanged after failed payment', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    var initialPoints = parseInt(pm.environment.get('initial_points'));",
              "    var currentPoints = jsonData.points || jsonData.balance || 0;",
              "    ",
              "    console.log('========================================');",
              "    console.log('ASSERTION - Points Verification:');",
              "    console.log('  Initial Points:', initialPoints);",
              "    console.log('  Current Points:', currentPoints);",
              "    console.log('========================================');",
              "    ",
              "    pm.expect(currentPoints).to.equal(initialPoints,",
              "        'Points should not change after failed payment');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/points/my/",
          "host": ["{{base_url}}"],
          "path": ["points", "my", ""]
        }
      }
    },
    {
      "name": "Step 11: Verify Order Status Not Paid (Assertion)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Order status is NOT paid after amount mismatch', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    var orderStatus = (jsonData.status || '').toLowerCase();",
              "    // confirmed는 '주문확정' 상태로 결제 전 상태임 (결제 완료가 아님)",
              "    var paidStatuses = ['paid', 'completed', 'success'];",
              "    ",
              "    console.log('========================================');",
              "    console.log('ASSERTION - Order Status Verification:');",
              "    console.log('  Order ID:', pm.environment.get('order_id'));",
              "    console.log('  Order Status:', orderStatus);",
              "    console.log('========================================');",
              "    ",
              "    pm.expect(paidStatuses).to.not.include(orderStatus,",
              "        'Order should NOT be marked as paid after amount mismatch');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/orders/{{order_id}}/",
          "host": ["{{base_url}}"],
          "path": ["orders", "{{order_id}}", ""]
        }
      }
    },
    {
      "name": "Step 12: Payment Confirm with HIGHER Amount (Additional Test)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Payment with higher amount is also REJECTED', function() {",
              "    // 금액이 더 높아도 불일치는 거부해야 함",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 401, 402, 403, 422, 409, 500]);",
              "    ",
              "    var correctAmount = parseInt(pm.environment.get('correct_amount'));",
              "    var higherAmount = correctAmount * 2;",
              "    ",
              "    console.log('========================================');",
              "    console.log('ACTION - Payment with Higher Amount:');",
              "    console.log('  Correct Amount:', correctAmount);",
              "    console.log('  Submitted Amount:', higherAmount);",
              "    console.log('  Response Status:', pm.response.code);",
              "    console.log('========================================');",
              "});",
              "",
              "pm.test('Higher amount payment NOT processed', function() {",
              "    pm.expect(pm.response.code).to.not.be.oneOf([200, 201]);",
              "});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// 올바른 금액의 2배 설정",
              "var correctAmount = parseInt(pm.environment.get('correct_amount'));",
              "pm.environment.set('higher_amount', correctAmount * 2);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"order_id\": {{order_id}},\n    \"payment_key\": \"{{payment_key}}_2\",\n    \"amount\": {{higher_amount}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/payments/confirm/",
          "host": ["{{base_url}}"],
          "path": ["payments", "confirm", ""]
        }
      }
    },
    {
      "name": "Step 13: Payment Confirm with ZERO Amount (Edge Case)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Payment with zero amount is REJECTED', function() {",
