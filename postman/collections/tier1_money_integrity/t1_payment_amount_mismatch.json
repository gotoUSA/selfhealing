              "    console.log('========================================');",
              "});",
              "",
              "pm.test('Zero amount payment NOT processed', function() {",
              "    pm.expect(pm.response.code).to.not.be.oneOf([200, 201]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"order_id\": {{order_id}},\n    \"payment_key\": \"{{payment_key}}_3\",\n    \"amount\": 0\n}"
        },
        "url": {
          "raw": "{{base_url}}/payments/confirm/",
          "host": ["{{base_url}}"],
          "path": ["payments", "confirm", ""]
        }
      }
    },
    {
      "name": "Step 14: Payment Confirm with NEGATIVE Amount (Edge Case)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Payment with negative amount is REJECTED', function() {",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 401, 402, 403, 422, 409, 500]);",
              "    ",
              "    console.log('========================================');",
              "    console.log('ACTION - Payment with Negative Amount:');",
              "    console.log('  Correct Amount:', pm.environment.get('correct_amount'));",
              "    console.log('  Submitted Amount: -1000');",
              "    console.log('  Response Status:', pm.response.code);",
              "    console.log('========================================');",
              "});",
              "",
              "pm.test('Negative amount payment NOT processed', function() {",
              "    pm.expect(pm.response.code).to.not.be.oneOf([200, 201]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
