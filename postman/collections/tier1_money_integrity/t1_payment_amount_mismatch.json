{
  "info": {
    "_postman_id": "t1-payment-amount-mismatch",
    "name": "t1-payment-amount-mismatch",
    "description": "결제 요청 금액과 실제 주문 금액이 불일치할 때 결제가 거부되는지 검증\n\n## 목적\n- 결제 금액 위변조 시도 차단\n- req.amount != final_amount → 거부\n\n## 검증 포인트\n- 금액 불일치 시 400/422 에러 반환\n- 결제가 처리되지 않아야 함\n- 재고/포인트 변동 없어야 함\n\n## CI 정책\n- 실패 시 배포 중단 (Tier 1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Step 1: Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login successful with valid contract', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    // 필수 필드 존재 검증",
              "    pm.expect(jsonData.token).to.exist;",
              "    pm.expect(jsonData.token.access).to.exist;",
              "    ",
              "    // 타입 검증",
              "    pm.expect(typeof jsonData.token.access).to.eql('string');",
              "    pm.expect(jsonData.token.access.length).to.be.above(10);",
              "    ",
              "    pm.environment.set('access_token', jsonData.token.access);",
              "    if (jsonData.token.refresh) {",
              "        pm.environment.set('refresh_token', jsonData.token.refresh);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{test_username}}\",\n    \"password\": \"{{test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login/",
          "host": ["{{base_url}}"],
          "path": ["auth", "login", ""]
        }
      }
    },
    {
      "name": "Step 2: Get Initial Points (Precondition)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Initial points retrieved', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    var currentPoints = jsonData.points || jsonData.balance || 0;",
              "    pm.environment.set('initial_points', currentPoints);",
              "    ",
              "    console.log('========================================');",
              "    console.log('PRECONDITION - Initial State:');",
              "    console.log('  Current Points:', currentPoints);",
              "    console.log('========================================');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/points/my/",
          "host": ["{{base_url}}"],
          "path": ["points", "my", ""]
        }
      }
    },
    {
      "name": "Step 3: Get Product Info (Precondition)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Product retrieved', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('product_price', jsonData.price);",
              "    pm.environment.set('initial_stock', jsonData.stock);",
              "    ",
              "    console.log('========================================');",
              "    console.log('PRECONDITION - Product State:');",
              "    console.log('  Product Price:', jsonData.price);",
              "    console.log('  Initial Stock:', jsonData.stock);",
              "    console.log('========================================');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/products/{{product_id}}/",
          "host": ["{{base_url}}"],
          "path": ["products", "{{product_id}}", ""]
        }
      }
    },
