{
  "info": {
    "_postman_id": "t1-payment-cancel-point-refund",
    "name": "T1_Payment_Cancel_PointRefund",
    "description": "결제 취소 시 사용한 포인트가 정확히 환불되는지 검증\n\n## 목적\n- 결제 취소 시 사용한 포인트가 사용자에게 환불되는지 확인\n- user.points += used_points\n\n## 검증 포인트\n- 취소 후 포인트 = 취소 전 포인트 + 사용한 포인트\n\n## CI 정책\n- 실패 시 배포 중단 (Tier 1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Step 1: Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login successful', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.token).to.exist;",
              "    pm.expect(jsonData.token.access).to.exist;",
              "    pm.environment.set('access_token', jsonData.token.access);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{test_username}}\",\n    \"password\": \"{{test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login/",
          "host": ["{{base_url}}"],
          "path": ["auth", "login", ""]
        }
      }
    },
    {
      "name": "Step 2: Get Initial Points",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Points retrieved successfully', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    // API 응답 구조: {point_info: {points: ...}, recent_histories: [...]}",
              "    var currentPoints = (jsonData.point_info && jsonData.point_info.points) || jsonData.points || jsonData.balance || 0;",
              "    pm.environment.set('initial_points', currentPoints);",
              "    ",
              "    console.log('========================================');",
              "    console.log('INITIAL STATE:');",
              "    console.log('  Current Points:', currentPoints);",
              "    console.log('========================================');",
              "});",
              "",
              "pm.test('Sufficient points for test', function() {",
              "    var jsonData = pm.response.json();",
              "    var currentPoints = (jsonData.point_info && jsonData.point_info.points) || jsonData.points || jsonData.balance || 0;",
              "    var usePoints = parseInt(pm.environment.get('use_points')) || 1000;",
              "    ",
              "    pm.expect(currentPoints).to.be.at.least(usePoints,",
              "        'Insufficient points for test. Required: ' + usePoints + ', Available: ' + currentPoints);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/points/my/",
          "host": ["{{base_url}}"],
          "path": ["points", "my", ""]
        }
      }
    },
