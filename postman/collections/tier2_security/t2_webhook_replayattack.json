{
  "info": {
    "_postman_id": "t2-webhook-replayattack",
    "name": "t2_webhook_replayattack",
    "description": "동일 webhook 재수신 무시 검증 (Replay Attack 방지)\n\n## 목적\n- 동일한 event.id로 웹훅 재전송 시 중복 처리 방지 확인\n- 리플레이 공격으로 인한 중복 결제/환불 방지\n\n## CI 정책\n- 실패 시 배포 중단 (Tier 2)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "step 1: login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login successful', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.token.access).to.exist;",
              "    pm.environment.set('access_token', jsonData.token.access);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{test_username}}\",\n    \"password\": \"{{test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login/",
          "host": ["{{base_url}}"],
          "path": ["auth", "login", ""]
        }
      }
    },
    {
      "name": "step 2: get user points before",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('points retrieved', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    // before 상태 저장",
              "    pm.environment.set('points_before', jsonData.points || jsonData.balance || 0);",
              "    console.log('points before:', pm.environment.get('points_before'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/points/my/",
          "host": ["{{base_url}}"],
          "path": ["points", "my", ""]
        }
      }
    },
    {
      "name": "step 3: generate unique event id (precondition)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// precondition: 고유한 webhook event id 생성",
              "var eventId = 'evt_' + pm.variables.replaceIn('{{$guid}}');",
              "pm.environment.set('webhook_event_id', eventId);",
              "",
              "// 결제 완료 금액 설정",
              "pm.environment.set('payment_amount', 50000);",
              "pm.environment.set('earned_points', 500);",
              "",
              "console.log('generated webhook event id:', eventId);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('first webhook processed successfully', function() {",
              "    // 200/201/204 = 웹훅 처리 성공",
              "    // 401 = 서명 검증으로 차단 (Replay Attack 방지의 첫 번째 방어선)",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204, 401]);",
              "    if (pm.response.code === 401) {",
              "        console.log('webhook blocked by signature verification (security feature)');",
              "    } else {",
              "        console.log('first webhook accepted');",
              "    }",
              "});",
              "",
              "// 첫 번째 처리 결과 저장",
              "pm.environment.set('first_webhook_processed', true);",
              "pm.environment.set('first_webhook_response', pm.response.text());"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Toss-Signature",
            "value": "{{webhook_signature}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"eventType\": \"PAYMENT_STATUS_CHANGED\",\n    \"eventId\": \"{{webhook_event_id}}\",\n    \"transactionId\": \"txn_{{$guid}}\",\n    \"paymentKey\": \"{{payment_key}}\",\n    \"orderId\": \"{{order_id}}\",\n    \"status\": \"DONE\",\n    \"approvedAt\": \"{{$isoTimestamp}}\",\n    \"amount\": {{payment_amount}},\n    \"method\": \"CARD\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/webhooks/toss/",
          "host": ["{{base_url}}"],
          "path": ["webhooks", "toss", ""]
        }
      }
    },
    {
      "name": "step 4: check points after first webhook",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('points updated after first webhook', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    var pointsAfterFirst = jsonData.points || jsonData.balance || 0;",
              "    pm.environment.set('points_after_first', pointsAfterFirst);",
              "    ",
              "    console.log('points after first webhook:', pointsAfterFirst);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/points/my/",
          "host": ["{{base_url}}"],
          "path": ["points", "my", ""]
        }
      }
    },
    {
      "name": "step 5: replay same webhook (attack simulation)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// action: 동일한 event id로 웹훅 재전송 (리플레이 공격)",
              "",
              "pm.test('replay webhook handled correctly', function() {",
              "    // 서버가 크래시하지 않음",
              "    pm.expect(pm.response.code).to.be.below(500);",
              "    ",
              "    // 가능한 응답:",
              "    // - 200 ok (이미 처리됨, 무시)",
              "    // - 409 conflict (중복 이벤트)",
              "    // - 400 bad request (중복 거부)",
              "    console.log('replay webhook response status:', pm.response.code);",
              "});",
              "",
              "pm.test('replay detected or safely ignored', function() {",
              "    var jsonData = pm.response.json();",
              "    var responseText = JSON.stringify(jsonData).toLowerCase();",
              "    ",
              "    // 중복 처리 관련 메시지 확인 (있다면)",
              "    var possibleMessages = [",
              "        'duplicate',",
              "        'already',",
              "        'processed',",
              "        'ignored',",
              "        'exists'",
              "    ];",
              "    ",
              "    console.log('replay response:', JSON.stringify(jsonData));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Toss-Signature",
            "value": "{{webhook_signature}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"eventType\": \"PAYMENT_STATUS_CHANGED\",\n    \"eventId\": \"{{webhook_event_id}}\",\n    \"transactionId\": \"txn_replay_attempt\",\n    \"paymentKey\": \"{{payment_key}}\",\n    \"orderId\": \"{{order_id}}\",\n    \"status\": \"DONE\",\n    \"approvedAt\": \"{{$isoTimestamp}}\",\n    \"amount\": {{payment_amount}},\n    \"method\": \"CARD\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/webhooks/toss/",
          "host": ["{{base_url}}"],
          "path": ["webhooks", "toss", ""]
        }
      }
    },
    {
      "name": "step 6: verify points not doubled (critical)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('points not duplicated after replay', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    var currentPoints = jsonData.points || jsonData.balance || 0;",
              "    var pointsAfterFirst = parseInt(pm.environment.get('points_after_first'));",
              "    ",
              "    // 핵심 검증: 리플레이 후에도 포인트가 첫 번째 처리 후와 동일해야 함",
              "    pm.expect(currentPoints).to.equal(pointsAfterFirst);",
              "    ",
              "    console.log('points after replay:', currentPoints);",
              "    console.log('points after first:', pointsAfterFirst);",
              "    console.log('replay attack blocked: points not doubled');",
              "});",
              "",
              "pm.test('no duplicate point earning', function() {",
              "    var jsonData = pm.response.json();",
              "    var currentPoints = jsonData.points || jsonData.balance || 0;",
              "    var earnedPoints = parseInt(pm.environment.get('earned_points'));",
              "    var pointsBefore = parseInt(pm.environment.get('points_before'));",
              "    ",
              "    // 적립은 1회만 이루어져야 함",
              "    var expectedPoints = pointsBefore + earnedPoints;",
              "    var doubledPoints = pointsBefore + (earnedPoints * 2);",
              "    ",
              "    pm.expect(currentPoints).to.not.equal(doubledPoints);",
              "    console.log('verified: points earned only once');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/points/my/",
          "host": ["{{base_url}}"],
          "path": ["points", "my", ""]
        }
      }
    },
    {
      "name": "step 7: multiple replay attempts",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('multiple replays also blocked', function() {",
              "    pm.expect(pm.response.code).to.be.below(500);",
              "    console.log('third attempt also handled safely');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Toss-Signature",
            "value": "{{webhook_signature}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"eventType\": \"PAYMENT_STATUS_CHANGED\",\n    \"eventId\": \"{{webhook_event_id}}\",\n    \"transactionId\": \"txn_replay_attempt_3\",\n    \"paymentKey\": \"{{payment_key}}\",\n    \"orderId\": \"{{order_id}}\",\n    \"status\": \"DONE\",\n    \"approvedAt\": \"{{$isoTimestamp}}\",\n    \"amount\": {{payment_amount}},\n    \"method\": \"CARD\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/webhooks/toss/",
          "host": ["{{base_url}}"],
          "path": ["webhooks", "toss", ""]
        }
      }
    },
    {
      "name": "step 8: final points verification",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('final points unchanged after all replays', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    var finalPoints = jsonData.points || jsonData.balance || 0;",
              "    var pointsAfterFirst = parseInt(pm.environment.get('points_after_first'));",
              "    ",
              "    pm.expect(finalPoints).to.equal(pointsAfterFirst);",
              "    ",
              "    console.log('=== security check passed ===');",
              "    console.log('replay attack prevention verified');",
              "    console.log('final points:', finalPoints);",
              "    console.log('expected points:', pointsAfterFirst);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/points/my/",
          "host": ["{{base_url}}"],
          "path": ["points", "my", ""]
        }
      }
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// collection-level pre-request script",
          "console.log('=== t2 security test: webhook replay attack prevention ===');"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// collection-level test script",
          "if (pm.response.code >= 500) {",
          "    console.error('server error:', pm.response.text());",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "test_username",
      "value": "test_user1"
    },
    {
      "key": "test_password",
      "value": "testpass123!"
    },
    {
      "key": "payment_key",
      "value": "test_payment_key_001"
    },
    {
      "key": "order_id",
      "value": "1"
    },
    {
      "key": "webhook_signature",
      "value": "test_signature"
    }
  ]
}
