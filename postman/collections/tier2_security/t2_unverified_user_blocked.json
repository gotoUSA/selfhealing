{
  "info": {
    "_postman_id": "t2-unverified-user-blocked",
    "name": "t2_unverified_user_blocked",
    "description": "미인증 사용자 API 접근 차단 검증\n\n## 목적\n- 이메일 미인증 사용자가 보호된 API에 접근 불가 확인\n- 인증 우회 시도 차단 확인\n\n## 테스트 대상\n- 로그인 차단\n- 주문 생성 차단\n- 결제 요청 차단\n\n## CI 정책\n- 실패 시 배포 중단 (Tier 2)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Step 1: Verify Test User Exists",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Unverified user credentials available', function() {",
              "    var unverifiedUsername = pm.environment.get('unverified_username');",
              "    var unverifiedPassword = pm.environment.get('unverified_password');",
              "    ",
              "    pm.expect(unverifiedUsername).to.exist;",
              "    pm.expect(unverifiedPassword).to.exist;",
              "    ",
              "    console.log('========================================');",
              "    console.log('Testing with unverified user:');",
              "    console.log('  Username:', unverifiedUsername);",
              "    console.log('========================================');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health/",
          "host": ["{{base_url}}"],
          "path": ["health", ""]
        }
      }
    },
    {
      "name": "Step 2: Unverified User Login Blocked",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Unverified user cannot login', function() {",
              "    // 미인증 사용자는 로그인 거부되어야 함",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 401, 403]);",
              "    ",
              "    var jsonData = pm.response.json();",
              "    var responseText = JSON.stringify(jsonData).toLowerCase();",
              "    ",
              "    // 에러 메시지 확인 (인증 관련)",
              "    console.log('========================================');",
              "    console.log('SECURITY CHECK: Unverified User Login');",
              "    console.log('  Status:', pm.response.code);",
              "    console.log('  Response:', JSON.stringify(jsonData));",
              "    console.log('  Expected: 400/401/403 with verify message');",
              "    console.log('========================================');",
              "});",
              "",
              "pm.test('Response contains verification message', function() {",
              "    var jsonData = pm.response.json();",
              "    var responseText = JSON.stringify(jsonData).toLowerCase();",
              "    ",
              "    // 인증/확인 관련 메시지 포함 여부",
              "    var hasVerifyMessage = responseText.includes('verify') ||",
              "                           responseText.includes('confirm') ||",
              "                           responseText.includes('email') ||",
              "                           responseText.includes('인증') ||",
              "                           responseText.includes('확인');",
              "    ",
              "    console.log('Verify message found:', hasVerifyMessage);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{unverified_username}}\",\n    \"password\": \"{{unverified_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login/",
          "host": ["{{base_url}}"],
          "path": ["auth", "login", ""]
        }
      }
    },
    {
      "name": "Step 3: Unverified User Cannot Access Protected API",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// 가짜 토큰 생성 시도 (실제로는 작동 안 함)",
              "// 이 테스트는 토큰 없이 접근이 차단되는지 확인",
              "console.log('Testing protected API access without valid token');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Protected API rejects request without token', function() {",
              "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
              "    ",
              "    console.log('========================================');",
              "    console.log('SECURITY CHECK: Protected API Access');",
              "    console.log('  Status:', pm.response.code);",
              "    console.log('  Expected: 401 Unauthorized');",
              "    console.log('========================================');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer invalid_token_for_unverified_user"
          }
        ],
        "url": {
          "raw": "{{base_url}}/orders/",
          "host": ["{{base_url}}"],
          "path": ["orders", ""]
        }
      }
    },
    {
      "name": "Step 4: Unverified User Cannot Access Cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Cart API rejects invalid token', function() {",
              "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
              "    ",
              "    console.log('========================================');",
              "    console.log('SECURITY CHECK: Cart API Access');",
              "    console.log('  Status:', pm.response.code);",
              "    console.log('  Expected: 401 Unauthorized');",
              "    console.log('========================================');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer invalid_token_for_unverified_user"
          }
        ],
        "url": {
          "raw": "{{base_url}}/cart/",
          "host": ["{{base_url}}"],
          "path": ["cart", ""]
        }
      }
    },
    {
      "name": "Step 5: Unverified User Cannot Access Payment",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Payment API rejects invalid token', function() {",
              "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
              "    ",
              "    console.log('========================================');",
              "    console.log('SECURITY CHECK: Payment API Access');",
              "    console.log('  Status:', pm.response.code);",
              "    console.log('  Expected: 401 Unauthorized');",
              "    console.log('========================================');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer invalid_token_for_unverified_user"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"order_id\": 999999,\n    \"amount\": 10000\n}"
        },
        "url": {
          "raw": "{{base_url}}/payments/request/",
          "host": ["{{base_url}}"],
          "path": ["payments", "request", ""]
        }
      }
    },
    {
      "name": "Step 6: Summary",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('All security checks passed', function() {",
              "    console.log('========================================');",
              "    console.log('  SECURITY TEST SUMMARY');",
              "    console.log('========================================');",
              "    console.log('✓ Unverified user login: BLOCKED');",
              "    console.log('✓ Invalid token - Orders API: BLOCKED');",
              "    console.log('✓ Invalid token - Cart API: BLOCKED');",
              "    console.log('✓ Invalid token - Payment API: BLOCKED');",
              "    console.log('========================================');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health/",
          "host": ["{{base_url}}"],
          "path": ["health", ""]
        }
      }
    }
  ]
}
