{
  "info": {
    "_postman_id": "t2-order-otheruser-forbidden",
    "name": "t2_order_otheruser_forbidden",
    "description": "타인 주문 조회 차단 검증\n\n## 목적\n- 다른 사용자의 주문을 조회하려 할 때 403/404 반환 확인\n- 권한 없는 리소스 접근 차단 검증\n\n## CI 정책\n- 실패 시 배포 중단 (Tier 2)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "step 1: login as user a",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('user a login successful', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.access).to.exist;",
              "    ",
              "    pm.environment.set('user_a_token', jsonData.access);",
              "    console.log('user a logged in');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"{{user_a_email}}\",\n    \"password\": \"{{user_a_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login/",
          "host": ["{{base_url}}"],
          "path": ["auth", "login", ""]
        }
      }
    },
    {
      "name": "step 2: user a creates order",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// 장바구니에 상품이 있다고 가정"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('user a order created', function() {",
              "    pm.response.to.have.status(201);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    // user a의 주문 id 저장 (before 상태)",
              "    pm.environment.set('user_a_order_id', jsonData.id || jsonData.order_id);",
              "    console.log('user a order id:', pm.environment.get('user_a_order_id'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{user_a_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"cart_item_ids\": [{{cart_item_id}}],\n    \"shipping_name\": \"user a\",\n    \"shipping_phone\": \"010-1111-1111\",\n    \"shipping_address\": \"서울시 강남구 테스트동 111\",\n    \"shipping_detail_address\": \"101호\",\n    \"shipping_postal_code\": \"11111\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/orders/",
          "host": ["{{base_url}}"],
          "path": ["orders", ""]
        }
      }
    },
    {
      "name": "step 3: user a can view own order",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('user a can access own order', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    // 자신의 주문은 정상 조회",
              "    pm.expect(jsonData.id || jsonData.order_id).to.exist;",
              "    console.log('user a successfully accessed own order');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_a_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/orders/{{user_a_order_id}}/",
          "host": ["{{base_url}}"],
          "path": ["orders", "{{user_a_order_id}}", ""]
        }
      }
    },
    {
      "name": "step 4: login as user b",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('user b login successful', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.access).to.exist;",
              "    ",
              "    pm.environment.set('user_b_token', jsonData.access);",
              "    console.log('user b logged in');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"{{user_b_email}}\",\n    \"password\": \"{{user_b_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login/",
          "host": ["{{base_url}}"],
          "path": ["auth", "login", ""]
        }
      }
    },
    {
      "name": "step 5: user b attempts to view user a order (forbidden)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// action: user b가 user a의 주문을 조회 시도",
              "",
              "pm.test('user b cannot access user a order', function() {",
              "    // 403 forbidden 또는 404 not found",
              "    pm.expect(pm.response.code).to.be.oneOf([403, 404]);",
              "    console.log('access correctly denied with status:', pm.response.code);",
              "});",
              "",
              "pm.test('no order data exposed to unauthorized user', function() {",
              "    var jsonData = pm.response.json();",
              "    ",
              "    // 주문 상세 정보가 노출되면 안 됨",
              "    pm.expect(jsonData.shipping_address).to.be.undefined;",
              "    pm.expect(jsonData.shipping_phone).to.be.undefined;",
              "    pm.expect(jsonData.items).to.be.undefined;",
              "    pm.expect(jsonData.total_amount).to.be.undefined;",
              "});",
              "",
              "pm.test('response does not leak user a information', function() {",
              "    var jsonData = pm.response.json();",
              "    var responseText = JSON.stringify(jsonData);",
              "    ",
              "    // user a의 개인정보가 노출되면 안 됨",
              "    pm.expect(responseText).to.not.include('user a');",
              "    pm.expect(responseText).to.not.include('010-1111-1111');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_b_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/orders/{{user_a_order_id}}/",
          "host": ["{{base_url}}"],
          "path": ["orders", "{{user_a_order_id}}", ""]
        }
      }
    },
    {
      "name": "step 6: user b attempts to cancel user a order (forbidden)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('user b cannot cancel user a order', function() {",
              "    // 403 forbidden 또는 404 not found",
              "    pm.expect(pm.response.code).to.be.oneOf([403, 404]);",
              "});",
              "",
              "pm.test('order not cancelled by unauthorized user', function() {",
              "    var jsonData = pm.response.json();",
              "    ",
              "    // 취소 성공 응답이 아니어야 함",
              "    pm.expect(jsonData.status).to.not.equal('cancelled');",
              "    pm.expect(jsonData.cancelled).to.not.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{user_b_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"cancel_reason\": \"unauthorized cancel attempt\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/orders/{{user_a_order_id}}/cancel/",
          "host": ["{{base_url}}"],
          "path": ["orders", "{{user_a_order_id}}", "cancel", ""]
        }
      }
    },
    {
      "name": "step 7: verify user a order unchanged",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('user a order still exists and unchanged', function() {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    ",
              "    // 주문이 취소되지 않았는지 확인",
              "    pm.expect(jsonData.status).to.not.equal('cancelled');",
              "    console.log('order status:', jsonData.status);",
              "});",
              "",
              "pm.test('order integrity maintained', function() {",
              "    var jsonData = pm.response.json();",
              "    var orderId = jsonData.id || jsonData.order_id;",
              "    ",
              "    pm.expect(orderId).to.equal(parseInt(pm.environment.get('user_a_order_id')));",
              "});",
              "",
              "console.log('=== security check passed ===');",
              "console.log('unauthorized access to other user order correctly blocked');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_a_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/orders/{{user_a_order_id}}/",
          "host": ["{{base_url}}"],
          "path": ["orders", "{{user_a_order_id}}", ""]
        }
      }
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// collection-level pre-request script",
          "console.log('=== t2 security test: other user order access forbidden ===');"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// collection-level test script",
          "if (pm.response.code >= 500) {",
          "    console.error('server error:', pm.response.text());",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "user_a_email",
      "value": "usera@example.com"
    },
    {
      "key": "user_a_password",
      "value": "testpass123!"
    },
    {
      "key": "user_b_email",
      "value": "userb@example.com"
    },
    {
      "key": "user_b_password",
      "value": "testpass123!"
    },
    {
      "key": "cart_item_id",
      "value": "1"
    }
  ]
}
