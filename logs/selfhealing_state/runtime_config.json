{
  "circuit_breaker": {
    "enabled": true,
    "failure_threshold": 15,
    "recovery_timeout": 60,
    "success_threshold": 2,
    "half_open_max_calls": 3
  },
  "dlq": {
    "enabled": true,
    "max_retries": 3,
    "retry_delay": 60,
    "expiry_hours": 72,
    "batch_size": 10
  },
  "retry": {
    "max_attempts": 3,
    "backoff_strategy": "exponential",
    "backoff_base": 4,
    "base_delay": 1.0,
    "max_delay": 300.0,
    "jitter": true,
    "jitter_percent": 25
  },
  "sla": {
    "thresholds_by_domain": {},
    "default_hours": 24
  },
  "metrics": {
    "enabled": true,
    "prefix": "selfhealing",
    "collection_interval": 60
  },
  "notification": {
    "enabled": true,
    "channels": [
      "email"
    ]
  },
  "rate_limit": {
    "base_delay": 1.0,
    "max_delay": 60.0,
    "jitter_percent": 30.0,
    "default_retry_after": 5.0,
    "backoff_multiplier": 2.0
  },
  "domain_configs": {},
  "auto_replay_enabled": true,
  "security_monitoring_enabled": true,
  "debug_mode": false
}