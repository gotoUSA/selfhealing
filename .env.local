# Stage 26 Local Testing Environment
USE_CONNECTION_POOL=TRUE
USE_POOL_CIRCUIT_BREAKER=TRUE
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=1

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=shopping_db
DATABASE_USER=shopping_user
DATABASE_PASSWORD=shopping_pass

# Redis
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────
# Audit Disk Buffer - 개발 환경 최적화
# ─────────────────────────────────────────────────────
# PID별 DB 생성 비활성화 (재시작 시 DB 누적 방지)
SELFHEALING_DISK_BUFFER_INCLUDE_PID_IN_DB_NAME=false
# 최대 엔트리 수: 10만 → 1만
SELFHEALING_DISK_BUFFER_MAX_ENTRIES=10000
# 보관 기간: 72시간 → 4시간
SELFHEALING_DISK_BUFFER_RETENTION_HOURS=4
# 정리 주기: 1시간 → 10분
SELFHEALING_DISK_BUFFER_CLEANUP_INTERVAL_SECONDS=600
